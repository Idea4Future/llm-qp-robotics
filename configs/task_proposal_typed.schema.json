{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opti-project:task-proposal:v1",
  "title": "Concise LLM optimization proposal envelope",
  "description": "Structural proposal contract. Typed entity enums are filtered at runtime to the selected execution profile; external catalog/intent validation rejects incompatible color/source pairs and hard-bound relaxation. Numbers are never repaired.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "proposal"
      ],
      "properties": {
        "status": {
          "const": "proposal"
        },
        "proposal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "object_id",
            "source_id",
            "destination_id",
            "destination_slot_id",
            "forbidden_zone_ids",
            "objective_weights",
            "constraint_bounds"
          ],
          "properties": {
            "schema_version": {
              "type": "integer",
              "const": 1
            },
            "object_id": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "redbin01",
                "bluebin01",
                "greenbin01"
              ]
            },
            "source_id": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "station_A",
                "station_B",
                "station_rack_A",
                "station_rack_B",
                "station_rack_C"
              ]
            },
            "destination_id": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "station_A",
                "station_B",
                "station_out"
              ]
            },
            "destination_slot_id": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "slot_B_1",
                "slot_out_1"
              ]
            },
            "forbidden_zone_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "enum": [
                  "corridor_lower",
                  "corridor_upper"
                ]
              }
            },
            "objective_weights": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "base_path_tracking",
                "base_effort",
                "base_command_change",
                "arm_tcp_tracking",
                "arm_joint_velocity",
                "arm_command_change"
              ],
              "properties": {
                "base_path_tracking": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                },
                "base_effort": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000
                },
                "base_command_change": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000
                },
                "arm_tcp_tracking": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000
                },
                "arm_joint_velocity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000
                },
                "arm_command_change": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000
                }
              }
            },
            "constraint_bounds": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "base_speed_max",
                "base_accel_max",
                "base_yaw_rate_max",
                "obstacle_clearance_min",
                "arm_joint_speed_max",
                "arm_joint_accel_max"
              ],
              "properties": {
                "base_speed_max": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "base_accel_max": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "base_yaw_rate_max": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "obstacle_clearance_min": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "arm_joint_speed_max": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "arm_joint_accel_max": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_code",
        "message",
        "hard_constraints_relaxed"
      ],
      "properties": {
        "status": {
          "const": "blocked"
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "hard_constraints_relaxed": {
          "const": false
        }
      }
    }
  ]
}
